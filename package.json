{
  "name": "meridian-electronics",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15 <25"
  },
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.js\" \"ng serve --host 127.0.0.1 --proxy-config proxy.json\"",
    "build": "ng build",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "format": "prettier --write src server tests *.json *.md",
    "format:check": "prettier --check src server tests *.json *.md"
  },
  "dependencies": {
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/forms": "22.2.4",
    "@angular/platform-browser": "22.2.4",
    "@angular/router": "22.2.4",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "rxjs": "~7.8.2"
  },
  "devDependencies": {
    "@angular/build": "22.2.5",
    "@angular/cli": "22.2.5",
    "@angular/compiler-cli": "22.2.4",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2"
  }
}
